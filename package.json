{
	"name": "stratus-base",
	"version": "0.0.1",
	"scripts": {
		"setup:js7z": "node scripts/setup-js7z.mjs",
		"dev": "npm run setup:js7z && vite dev",
		"build": "npm run setup:js7z && vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "npm run setup:js7z && (svelte-kit sync || echo '')",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "npm run setup:js7z && node --experimental-strip-types --test \"src/lib/**/*.test.ts\"",
		"test:browser": "npm run setup:js7z && vitest run --config vitest.config.ts"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"docs",
		"licenses"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"publint": "^0.3.21",
		"svelte": "^5.56.1",
		"svelte-akui": "github:AshKyd/svelte-akui",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16"
	},
	"keywords": [
		"svelte"
	],
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1111.0",
		"@vitest/browser": "^4.1.10",
		"dropbox": "^10.45.0",
		"pathe": "^2.0.3",
		"playwright": "^1.62.1",
		"s3rver": "^3.7.1",
		"vitest": "^4.1.10",
		"zx": "^8.8.5"
	}
}
